    </details>
    <details>
      <summary>Sports</summary>
      <ul>
        <li>🏂 Snowboarding</li>
        <li>⛰️ Hiking</li>
        <li>🏋️‍♂️ Gym</li>
        <li>🕸️ In the past: tennis, basketball</li>
      </ul>
    </details>
    <h2 id="curriculum">Curriculum</h2>
    <nav class="curriculum-actions" aria-label="Curriculum actions">
      <button type="button" id="copy-markdown-button" data-markdown-source="/documents/Miguel-Cordero-CV.md">
        Copy .md
      </button>
      <a class="action-link" href="/documents/Miguel-Cordero-CV.pdf" target="_blank" rel="noopener">Open CV <span aria-hidden="true">↗</span></a>
    </nav>
    <p id="copy-markdown-status" class="copy-status" aria-live="polite"></p>
    <h2 id="contact">Contact</h2>
    <nav>
      <a class="action-link" href="mailto:miguelcorderocollar@gmail.com">Email ↗</a>
      <a class="action-link" href="https://www.linkedin.com/in/mcorderocollar/" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="action-link" href="https://github.com/miguelcorderocollar" target="_blank" rel="noopener">GitHub ↗</a>
      <a class="action-link" href="https://www.youtube.com/@MiguelCorderoDEV" target="_blank" rel="noopener">YouTube ↗</a>
    </nav>
    <div class="footer-info">
      <p class="last-updated">Last updated: October 2026</p>
    </div>
    </main>
    </div>

    <!-- Back to Top Button -->
    <button class="back-to-top" aria-label="Back to top">
      ↑
    </button>

    <script is:inline type="module" src="/homepage.js"></script>

</SiteLayout>
