---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found | Miguel Cordero Collar" description="Personal website of Miguel Cordero Collar." bodyClass="mcc-style mcc-dark" styles={["/assets/personal-style/personal-style.css", "/404.css"]} baseStyles={false} header={false} noindex>
<Fragment slot="head" set:html={""} />

    <main class="not-found" aria-labelledby="page-title">
      <p class="not-found__code" aria-hidden="true"><span class="not-found__digit">4</span><span class="not-found__zero">0</span><span class="not-found__digit">4</span></p>
      <p class="not-found__eyebrow">ROUTE NOT FOUND <span aria-hidden="true">/</span> 404</p>
      <h1 class="mcc-title" id="page-title">This route returned null.</h1>
      <p class="not-found__message">The page you’re looking for isn’t here. Let’s get you back to the homepage.</p>
      <a class="not-found__home" href="/">Back to homepage <span aria-hidden="true">→</span></a>
    </main>

</SiteLayout>
