{
  "name": "miguelcorderocollar-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8000",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 8000",
    "check": "astro check && python3 scripts/validate_people.py && python3 scripts/build_projects.py --check",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.7",
    "@astrojs/rss": "4.0.19"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3"
  }
}
