---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatBlogDate, getPublishedPosts, type BlogPost } from '../../lib/blog';
import '../../styles/blog.css';
export async function getStaticPaths() {
  return (await getPublishedPosts()).map(post => ({params: {slug: post.data.slug}, props: {post}}));
}
interface Props { post: BlogPost }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonicalPath = `/blog/${post.data.slug}/`;
const canonical = new URL(canonicalPath, Astro.site);
const readingMinutes = Math.max(1, Math.ceil((post.body || '').split(/\s+/).length / 200));
const contents = headings.filter(heading => heading.depth === 2);
const schema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title,
  description: post.data.description, datePublished: post.data.published.toISOString(),
  mainEntityOfPage: canonical.href, url: canonical.href,
  author: {'@type': 'Person', name: 'Miguel Cordero Collar', url: Astro.site?.href},
};
---
<SiteLayout title={`${post.data.title} | Miguel Cordero Collar`} description={post.data.description} canonicalPath={canonicalPath} socialType="article" socialImage="/images/bg/mountains-after-hours.png" twitterCard="summary_large_image" bodyClass="mcc-style mcc-dark collection-page blog-article-page">
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href={`${canonical}index.md`} />
    <meta property="article:published_time" content={post.data.published.toISOString()} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
  </Fragment>
  <main id="main-content">
    <nav class="article-back" aria-label="Breadcrumb"><a href="/blog/">← All writing</a></nav>
    <article>
      <header class="article-heading">
        <div class="article-meta"><time datetime={post.data.published.toISOString()}>{formatBlogDate(post.data.published)}</time><span>{readingMinutes} min read</span>{post.data.tags.includes('sample') && <span class="blog-sample">Sample article</span>}</div>
        <h1 class="mcc-title">{post.data.title}</h1><p class="article-deck">{post.data.description}</p>
        <ul class="blog-tags" aria-label="Topics">{post.data.tags.map(tag => <li>{tag}</li>)}</ul>
      </header>
      <div class="article-grid">
        <aside class="article-aside"><nav aria-label="On this page"><p class="blog-eyebrow">On this page</p><ol>{contents.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav><a class="article-markdown" href={`${canonicalPath}index.md`} type="text/markdown">Read as Markdown ↗</a></aside>
        <div class="article-prose"><Content /></div>
      </div>
      <footer class="article-footer"><a href="/blog/">← Back to all writing</a><a href="/rss.xml">Follow via RSS ↗</a></footer>
    </article>
  </main>
</SiteLayout>
