{
  "name": "miguelcorderocollar-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8000",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 8000",
    "check": "astro check && python3 scripts/validate_people.py && python3 scripts/build_projects.py --check",
    "test": "BLOG_SAMPLES=1 npm run build && BLOG_SAMPLES=1 node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "@astrojs/rss": "4.0.19",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "typescript": "5.9.3"
  }
}
