      </ul>
    </details>
    <details>
      <summary>Knowledge</summary>
      <ul>
        <li>Investing</li>
        <li>Economics</li>
        <li>Gardening</li>
        <li>Cooking and Food Science</li>
        <li>Philosophy</li>
